---> Postfix Evaluation[GeeksForGeeks]

int evaluatePostfix(char* str[], int size) {
    
    int result,a,b;
    int stack[size];
    int top=-1;
    if (size==1){
            int c=atoi(str[0]);
            return c;
        }
     for(int i=0;i<size;i++){
        if (isdigit(str[i][0]) || (str[i][0]=='-'&& isdigit(str[i][1]))){
                stack[++top]=atoi(str[i]);}
            else{
                b=stack[top--];
                a=stack[top--];

                switch(str[i][0]){
                    case '+':
                    result=a+b;
                    break;

                    case '-':
                    result=a-b;
                    break;

                    case '*':
                    result=a*b;
                    break;

                    case '/':
                    result=floor((double)a/b);
                    break;
                    
                    case '^':
                    result=pow(a,b);
                    break;
                }
            stack[++top]=result;
            }
        }
            return result;
        }
