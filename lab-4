---> 20. Valid Parentheses

char stack[10000];
int top;

void push(char value){
    if(top==9999){
        return;
    }
    else
    stack[++top]=value;
}

char pop(){
    if(top==-1){
        return'\0';
    }
    else
    return stack[top--];
}

bool isValid(char* s) {
    top=-1;
   

    for(int i=0;s[i]!='\0';i++){
        if(s[i]=='('||s[i]=='{'||s[i]=='['){
            push(s[i]);
        }
        else{

            char ele=pop();

            if(ele=='\0'){
                return false;
            }
            if((ele=='('&&s[i]!=')')||(ele=='{'&&s[i]!='}')||(ele=='['&&s[i]!=']'))
                return false;
        }
        
    }
    return top==-1;
}

----> Operations on Stack

#include <stdio.h>
#include<stdbool.h>

int stack[6];
int top;

bool isEmpty(){
    if (top==-1)
    return true;
    else
    return false;
}

bool isFull(){
    if(top==5)
    return true;
    else 
    return false;
}

void push(int value){
    if(isFull()){
    printf("\nOverflow");
    return;
    }
    else
    ++top;
    stack[top]=value;
    printf("\npush=%d",stack[top]);
}

void pop(){
    if(isEmpty()){
        printf("\nUnderflow");
        return;
    }
    else{
    printf("\npop = %d",stack[top]);
    --top;
        return;
    }
    
}

void peek(){
    printf("\npeek=%d",stack[top]);
}
int main() {
	top=-1;
	push(10);
	push(20);
	pop();
	pop();
	pop();
	peek();
}

